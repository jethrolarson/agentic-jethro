{
  "name": "agentic-jethro",
  "version": "0.5.0",
  "description": "OpenCode plugin for agentic-jethro: registers the prompting, hazard-driven-skills, and grill-me skills and re-injects the prompting self-apply rule at subagent-prompt delivery time (ports the Claude Code plugin's PreToolUse[Agent] hook).",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "skills"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck"
  },
  "keywords": [
    "opencode",
    "plugin",
    "skills",
    "prompting",
    "agentic"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.11",
    "@types/node": "^26.1.2",
    "typescript": "^5.0.0"
  }
}
